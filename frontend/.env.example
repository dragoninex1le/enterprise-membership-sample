# Local development — copy to frontend/.env.local and fill in.
# .env.local is gitignored; never commit real values.
#
# Tier 2 acceptance-test credentials are NOT here — see ../.env.tier2.example.

# Base URL of the Porth API (no trailing slash).
VITE_API_BASE_URL=https://<your-api-id>.execute-api.us-east-1.amazonaws.com/prod

# Base URL of the sample-app API. Falls back to VITE_API_BASE_URL when unset, which is
# usually wrong outside local dev — the sample app is a separate HttpApi.
VITE_SAMPLE_APP_API_URL=

# Tenant to use on localhost, where there is no subdomain to resolve from.
# In a deployed environment the tenant comes from the hostname.
VITE_DEV_TENANT_ID=

# The subdomain that maps to the reserved `platform` tenant rather than a customer tenant
# (e.g. `porth-sample` in porth-sample.ems.estynsoftware.cloud). Without it the platform
# admin UI resolves to a tenant that does not exist.
VITE_PLATFORM_APEX=porth-sample

# Set to 'true' to bypass the IdP and inject a fake authenticated user. Playwright sets this
# itself via webServer.env for Tier 1 — you only need it when running the dev server by hand.
VITE_E2E_AUTH=false
