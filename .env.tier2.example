# ─── Tier 2 acceptance tests ──────────────────────────────────────────────────
# Credentials for Playwright tests that run against the REAL deployed stack.
# In CI these are GitHub Actions secrets. Locally, copy to .env.tier2 (gitignored)
# and source it before `npx playwright test tests/e2e/tier2/`.
#
# Local-dev frontend config lives in frontend/.env.example, not here.
#
# NOTE: this repo is PUBLIC. Passwords below are being migrated to SSM SecureString
# (see PORTH-533) because Actions logs are world-readable and GitHub masks only the
# exact registered value — not one embedded in a JSON body or an error trace.

# Full URL of the deployed tenant subdomain (used by tenant/controller user tests)
PLAYWRIGHT_BASE_URL=https://demo-tenant.your-stack.example.com

# Full URL of the platform admin UI (root subdomain — different from the tenant URL)
# e.g. https://porth-sample.your-stack.example.com
# Required for Tier 2 tests — cannot be derived automatically from PLAYWRIGHT_BASE_URL.
PORTH_PLATFORM_BASE_URL=https://porth-sample.your-stack.example.com

# Porth API base URL (no trailing slash) — used to seed permissions/roles via API
# before the Playwright UI tests run (tenant-admin role must exist for login to work)
PORTH_API_URL=https://api.your-stack.example.com

# Service token for direct Porth API calls (seeding permissions + roles).
# Matches the AuthTestToken passed to the SAR install by porth-install.yml.
PORTH_AUTH_TEST_TOKEN=

# Platform admin credentials (Estyn operator — can create orgs and tenants)
PORTH_PLATFORM_ADMIN_EMAIL=platform-admin@your-domain.com
PORTH_PLATFORM_ADMIN_PASSWORD=

# Controller user credentials (has controller role in the test tenant)
# In Auth0 this user must have the "controller" role assigned so the JWT claim resolves
PORTH_TENANT_USER_EMAIL=controller@your-domain.com
PORTH_TENANT_USER_PASSWORD=
