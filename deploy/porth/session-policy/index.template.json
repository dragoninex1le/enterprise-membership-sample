{
  "context_rules": [
    {
      "match": {
        "host_pattern": "sample-api.{{ENV_SLOT}}.ems.estynsoftware.cloud"
      },
      "context_hint": "sample-{{ENV_SLOT}}"
    },
    {
      "match": {
        "host_pattern": "*"
      },
      "context_hint": "porth"
    }
  ],
  "bindings": {
    "sample-{{ENV_SLOT}}:/sample": {
      "role_types": [
        "tenant"
      ],
      "role_arn": "arn:aws:iam::{account}:role/ems-sample-app-${role_type}-{{ENV_SLOT}}",
      "session_policy_arns": [
        "arn:aws:iam::{account}:policy/ems-sample-app-${role_type}-session-{{ENV_SLOT}}"
      ]
    },
    "porth:/": {
      "role_types": [
        "tenant",
        "platform-admin"
      ],
      "role_arn": "arn:aws:iam::{account}:role/porth-${role_type}-{{ENV}}",
      "session_policy_arns": [
        "arn:aws:iam::{account}:policy/porth-${role_type}-session-{{ENV}}"
      ]
    }
  }
}
