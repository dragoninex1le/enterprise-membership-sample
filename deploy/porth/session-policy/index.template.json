{
  "context_rules": [
    { "match": { "host_pattern": "*" }, "context_hint": "porth" }
  ],
  "bindings": {
    "porth:/": {
      "role_types": ["tenant", "platform-admin"],
      "role_arn": "arn:aws:iam::{account}:role/porth-${role_type}-{{ENV}}",
      "session_policy_arns": [
        "arn:aws:iam::{account}:policy/porth-${role_type}-session-{{ENV}}"
      ]
    }
  }
}
