{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PlatformOperatorKeyedAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": ["ENV#$env#*"]
        }
      }
    },
    {
      "Sid": "PlatformOperatorScan",
      "Effect": "Allow",
      "Action": ["dynamodb:Scan"],
      "Resource": "*"
    }
  ]
}
